# ============================================================================
# ThinkTogether Frontend Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in the values
# DO NOT commit .env.local to version control

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV=development

# ============================================================================
# API CONFIGURATION (Required)
# ============================================================================
# Backend API URL - Update this to point to your backend server
NEXT_PUBLIC_API_URL=http://localhost:5000

# Socket.io URL for real-time features (Optional - defaults to API_URL)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features without code changes
# Set to 'true' or 'false'

# Social login (Google, Facebook, etc.)
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=false

# Video questions in quizzes
NEXT_PUBLIC_ENABLE_VIDEO_QUESTIONS=true

# AI-powered question generation
NEXT_PUBLIC_ENABLE_AI_GENERATION=false

# Analytics and tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Live chat support
NEXT_PUBLIC_ENABLE_LIVE_CHAT=false

# Mock data for development/testing
NEXT_PUBLIC_ENABLE_MOCK_DATA=false

# ============================================================================
# THIRD-PARTY SERVICES (Optional)
# ============================================================================

# Google Analytics
# Get your tracking ID from https://analytics.google.com
NEXT_PUBLIC_GA_ID=

# Sentry Error Tracking
# Get your DSN from https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# Intercom Live Chat
# Get your app ID from https://www.intercom.com
NEXT_PUBLIC_INTERCOM_APP_ID=

# ============================================================================
# AZURE STORAGE (Optional - for production file uploads)
# ============================================================================
# Azure Storage connection string for media uploads
AZURE_STORAGE_CONNECTION_STRING=

# Azure Storage container name
AZURE_STORAGE_CONTAINER_NAME=thinktogether-media

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================
# These are automatically set based on NODE_ENV
# Uncomment to override

# Enable React DevTools
# NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Enable verbose logging
# NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=true

# ============================================================================
# NOTES
# ============================================================================
# - All variables starting with NEXT_PUBLIC_ are exposed to the browser
# - Never commit sensitive data to version control
# - Use different .env files for different environments:
#   - .env.local (local development)
#   - .env.development (development server)
#   - .env.production (production server)
# - Restart the dev server after changing environment variables

