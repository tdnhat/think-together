# Top-most EditorConfig file
root = true

# Apply to all C# files
[*.cs]

#### Naming Conventions ####
# Style rule: Use PascalCase for type names
dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# ... (many other naming rules for methods, properties, etc.)

#### Code Style Preferences ####
# Style rule: Prefer 'var' when the type is apparent
csharp_style_var_when_type_is_apparent = true:suggestion

# Style rule: Prefer braces on the same line
csharp_new_line_before_open_brace = none

# Style rule: Add accessibility modifiers (public, private, etc.)
dotnet_style_require_accessibility_modifiers = always:suggestion

# Style rule: Prefer expression-bodied members for simple methods/properties
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

#### Code Quality Analysis ####
# Enable all recommended and latest analysis rules
# This is the most important part!
# It turns on hundreds of checks for bugs, performance, and design issues.
EnableNETAnalyzers = true
AnalysisLevel = latest-recommended